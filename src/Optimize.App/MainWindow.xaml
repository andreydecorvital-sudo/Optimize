<Window x:Class="Optimize.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Optimize"
        Width="1280"
        Height="820"
        MinWidth="1050"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource PageBackgroundBrush}"
        StateChanged="HandleWindowStateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource PageBackgroundBrush}"
            BorderBrush="#202735"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="246" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="18,0,0,0">
                        <Border Width="27" Height="27" Background="{StaticResource PrimaryBrush}" CornerRadius="8">
                            <TextBlock Text="O"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="OPTIMIZE"
                                   Margin="10,0,0,0"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <Border Margin="9,0,0,0" Padding="7,3" Background="#18202C" CornerRadius="5">
                            <TextBlock Text="PREVIEW" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" />
                        <TextBlock Text="{Binding ComputerName}"
                                   Margin="8,0,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="  ·  leitura local"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="&#xE921;"
                                Style="{StaticResource WindowButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeWindow" />
                        <Button x:Name="MaximizeButton"
                                Content="&#xE922;"
                                Style="{StaticResource WindowButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="ToggleMaximizeWindow" />
                        <Button Content="&#xE8BB;"
                                Style="{StaticResource CloseWindowButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseWindow" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="246" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="18,22,18,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="COMPUTADOR"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding HealthLabel}"
                                       Margin="0,7,0,0"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="20" />
                            <TextBlock Text="{Binding LastScanText}"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <RadioButton Content="Visão geral" Tag="&#xE80F;" GroupName="Navigation" IsChecked="True"
                                         Style="{StaticResource NavItemStyle}"
                                         Command="{Binding NavigateCommand}" CommandParameter="overview" />
                            <RadioButton Content="Hardware" Tag="&#xE950;" GroupName="Navigation"
                                         Style="{StaticResource NavItemStyle}"
                                         Command="{Binding NavigateCommand}" CommandParameter="hardware" />
                            <RadioButton Content="Armazenamento" Tag="&#xEDA2;" GroupName="Navigation"
                                         Style="{StaticResource NavItemStyle}"
                                         Command="{Binding NavigateCommand}" CommandParameter="storage" />
                            <RadioButton Content="Inicialização" Tag="&#xE7E8;" GroupName="Navigation"
                                         Style="{StaticResource NavItemStyle}"
                                         Command="{Binding NavigateCommand}" CommandParameter="startup" />
                            <RadioButton Content="Atualizações" Tag="&#xE895;" GroupName="Navigation"
                                         Style="{StaticResource NavItemStyle}"
                                         Command="{Binding NavigateCommand}" CommandParameter="updates" />
                            <RadioButton Content="Otimizações" Tag="&#xE945;" GroupName="Navigation"
                                         Style="{StaticResource NavItemStyle}"
                                         Command="{Binding NavigateCommand}" CommandParameter="optimizations" />
                        </StackPanel>

                        <Border Grid.Row="4"
                                Background="#111722"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="13"
                                Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="MODO SEGURO"
                                               Margin="8,0,0,0"
                                               FontFamily="Segoe UI Semibold"
                                               FontSize="10"
                                               Foreground="{StaticResource SuccessBrush}" />
                                </StackPanel>
                                <TextBlock Text="Nenhuma configuração é alterada nesta versão."
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           LineHeight="17"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="112" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="34,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentPageTitle}"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="27" />
                                <TextBlock Text="{Binding CurrentPageSubtitle}"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#121824"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="13,10"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="{Binding StatusText}"
                                               MaxWidth="270"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" />
                                </Border>
                                <Button Command="{Binding ScanCommand}"
                                        Content="{Binding ScanButtonText}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="150" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <Grid Margin="34,28,34,38">
                            <StackPanel Visibility="{Binding IsOverviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="94" Height="94" CornerRadius="47" Background="{StaticResource PrimarySoftBrush}">
                                                <Grid>
                                                    <Ellipse Stroke="#3A2E75" StrokeThickness="1" Margin="4" />
                                                    <TextBlock Text="{Binding Score}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe UI Semibold"
                                                               FontSize="35" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="16,4,0,0">
                                                <TextBlock Text="SAÚDE DO PC" FontFamily="Segoe UI Semibold" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding HealthLabel}" Margin="0,8,0,0" FontFamily="Segoe UI Semibold" FontSize="24" />
                                                <TextBlock Text="Nota baseada em espaço, memória, inicialização e estado do Windows."
                                                           Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="18"
                                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="MEMÓRIA" FontFamily="Segoe UI Semibold" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding MemoryUsagePercent, StringFormat={}{0:0}%}"
                                                           HorizontalAlignment="Right" FontFamily="Segoe UI Semibold" FontSize="20" />
                                            </Grid>
                                            <TextBlock Text="{Binding MemorySummary}" Margin="0,17,0,0" FontFamily="Segoe UI Semibold" FontSize="15" TextWrapping="Wrap" />
                                            <ProgressBar Value="{Binding MemoryUsagePercent}" Maximum="100" Margin="0,17,0,0" Style="{StaticResource MetricProgressStyle}" />
                                            <TextBlock Text="{Binding ProcessSummary}" Margin="0,11,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="INICIALIZAÇÃO" FontFamily="Segoe UI Semibold" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding StartupItemCount}" Margin="0,13,0,0" FontFamily="Segoe UI Semibold" FontSize="30" />
                                            <TextBlock Text="entradas detectadas" Margin="0,-2,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding UptimeSummary}" Margin="0,13,0,0" TextWrapping="Wrap" LineHeight="18" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="0.8*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Componentes principais" FontFamily="Segoe UI Semibold" FontSize="17" />
                                            <Border Margin="0,18,0,0" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="11" Padding="15">
                                                <StackPanel>
                                                    <TextBlock Text="PROCESSADOR" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding Processor}" Margin="0,5,0,0" TextWrapping="Wrap" FontFamily="Segoe UI Semibold" />
                                                </StackPanel>
                                            </Border>
                                            <Border Margin="0,10,0,0" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="11" Padding="15">
                                                <StackPanel>
                                                    <TextBlock Text="PLACA DE VÍDEO" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding GraphicsAdapter}" Margin="0,5,0,0" TextWrapping="Wrap" FontFamily="Segoe UI Semibold" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Unidades" FontFamily="Segoe UI Semibold" FontSize="17" />
                                                <TextBlock Text="{Binding Drives.Count, StringFormat={}{0} detectada(s)}" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Drives}" Margin="0,16,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="11" Padding="14" Margin="0,0,0,9">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <TextBlock FontFamily="Segoe UI Semibold">
                                                                        <Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding Label}" />
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding FreePercent, StringFormat={}{0:0}% livre}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                                </Grid>
                                                                <ProgressBar Value="{Binding FreePercent}" Maximum="100" Margin="0,11,0,0" Style="{StaticResource MetricProgressStyle}" />
                                                                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11">
                                                                    <Run Text="{Binding FreeGb}" /><Run Text=" GB livres de " /><Run Text="{Binding TotalGb}" /><Run Text=" GB" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Pontos que merecem atenção" FontFamily="Segoe UI Semibold" FontSize="17" />
                                            <TextBlock Text="{Binding Recommendations.Count, StringFormat={}{0} resultado(s)}" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,15,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,0,0,9">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="3" Background="{StaticResource PrimaryBrush}" CornerRadius="2" />
                                                            <StackPanel Grid.Column="1" Margin="13,0,16,0">
                                                                <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Semibold" FontSize="13" />
                                                                <TextBlock Text="{Binding Description}" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="18" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Background="#202838" CornerRadius="6" Padding="8,4" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding Severity}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsHardwareVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="PROCESSADOR" FontFamily="Segoe UI Semibold" FontSize="10" Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Text="{Binding Processor}" Margin="0,14,0,0" FontFamily="Segoe UI Semibold" FontSize="19" TextWrapping="Wrap" />
                                            <TextBlock Text="Clocks, consumo e temperaturas entrarão no módulo de sensores." Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="PLACA DE VÍDEO" FontFamily="Segoe UI Semibold" FontSize="10" Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Text="{Binding GraphicsAdapter}" Margin="0,14,0,0" FontFamily="Segoe UI Semibold" FontSize="19" TextWrapping="Wrap" />
                                            <TextBlock Text="A próxima etapa separará adaptadores físicos e virtuais automaticamente." Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Memória RAM" FontFamily="Segoe UI Semibold" FontSize="17" />
                                                <TextBlock Text="{Binding MemoryUsagePercent, StringFormat={}{0:0}% em uso}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Grid>
                                            <TextBlock Text="{Binding MemorySummary}" Margin="0,19,0,0" FontFamily="Segoe UI Semibold" FontSize="22" />
                                            <ProgressBar Value="{Binding MemoryUsagePercent}" Maximum="100" Margin="0,17,0,0" Style="{StaticResource MetricProgressStyle}" />
                                            <TextBlock Text="{Binding ProcessSummary}" Margin="0,11,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Sistema" FontFamily="Segoe UI Semibold" FontSize="17" />
                                            <TextBlock Text="{Binding SystemSummary}" Margin="0,18,0,0" FontFamily="Segoe UI Semibold" FontSize="17" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ComputerName}" Margin="0,9,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding UptimeSummary}" Margin="0,9,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsStorageVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Unidades disponíveis" FontFamily="Segoe UI Semibold" FontSize="19" />
                                        <TextBlock Text="Espaço livre detectado diretamente pelo Windows" Margin="0,5,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <ItemsControl ItemsSource="{Binding Drives}" Margin="0,20,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="52" Height="52" Background="#20283A" CornerRadius="13" HorizontalAlignment="Left">
                                                                <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A999FF" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock FontFamily="Segoe UI Semibold" FontSize="15">
                                                                    <Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding Label}" />
                                                                </TextBlock>
                                                                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                                                    <Run Text="{Binding FileSystem}" /><Run Text=" · " /><Run Text="{Binding TotalGb}" /><Run Text=" GB no total" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <Grid>
                                                                    <TextBlock Text="Espaço livre" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                                                    <TextBlock Text="{Binding FreePercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontFamily="Segoe UI Semibold" />
                                                                </Grid>
                                                                <ProgressBar Value="{Binding FreePercent}" Maximum="100" Margin="0,8,0,0" Style="{StaticResource MetricProgressStyle}" />
                                                                <TextBlock Text="{Binding FreeGb, StringFormat={}{0:0.0} GB disponíveis}" Margin="0,7,0,0" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsStartupVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.72*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1.28*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="ENTRADAS DETECTADAS" FontFamily="Segoe UI Semibold" FontSize="10" Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Text="{Binding StartupItemCount}" Margin="0,12,0,0" FontFamily="Segoe UI Semibold" FontSize="52" />
                                            <TextBlock Text="programas ou componentes carregados automaticamente" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Como esta área funcionará" FontFamily="Segoe UI Semibold" FontSize="18" />
                                            <TextBlock Text="O Optimize já contabiliza as entradas básicas. A próxima etapa mostrará nome, fabricante, impacto estimado e recomendação individual antes de permitir qualquer desativação."
                                                       Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <Border Margin="0,18,0,0" Background="#181F2B" CornerRadius="10" Padding="14">
                                                <TextBlock Text="Nenhum item será desativado em lote ou sem explicação." Foreground="{StaticResource SuccessBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsUpdatesVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="ESTADO DO WINDOWS" FontFamily="Segoe UI Semibold" FontSize="10" Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Text="{Binding RestartSummary}" Margin="0,14,0,0" FontFamily="Segoe UI Semibold" FontSize="20" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding LastScanText}" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="VERSÃO DO SISTEMA" FontFamily="Segoe UI Semibold" FontSize="10" Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Text="{Binding SystemSummary}" Margin="0,14,0,0" FontFamily="Segoe UI Semibold" FontSize="18" TextWrapping="Wrap" />
                                            <TextBlock Text="Drivers e aplicativos serão verificados por fontes oficiais, sem driver boosters genéricos."
                                                       Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsOptimizationsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.25*" /><ColumnDefinition Width="34" /><ColumnDefinition Width="0.75*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Border Width="58" Height="58" Background="{StaticResource PrimarySoftBrush}" CornerRadius="16" HorizontalAlignment="Left">
                                                <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B3A4FF" />
                                            </Border>
