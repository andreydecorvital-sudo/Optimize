<Window x:Class="Optimize.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimize"
        Width="1240"
        Height="800"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,24,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="O"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="OPTIMIZE" FontFamily="Segoe UI Semibold" FontSize="16" />
                            <TextBlock Text="PC INSPECTION" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding ComputerName}"
                               Margin="0,15,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content="Visão geral"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="overview" />
                    <Button Content="Hardware"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="hardware" />
                    <Button Content="Armazenamento"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="storage" />
                    <Button Content="Inicialização"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="startup" />
                    <Button Content="Atualizações"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="updates" />
                    <Button Content="Otimizações"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="optimizations" />
                </StackPanel>

                <Border Grid.Row="4"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="13">
                    <StackPanel>
                        <TextBlock Text="MODO SEGURO"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="10"
                                   Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Esta versão apenas lê o computador. Nenhuma configuração é alterada."
                                   Margin="0,7,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   LineHeight="17"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="112" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="32,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="27" />
                        <TextBlock Text="{Binding CurrentPageSubtitle}"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13" />
                        <TextBlock Text="{Binding LastScanText}"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding ScanCommand}"
                            Content="{Binding ScanButtonText}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="150"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="32,26,32,36">
                    <StackPanel Visibility="{Binding IsOverviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="NOTA DO PC" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding Score}" Margin="0,10,0,0" FontFamily="Segoe UI Semibold" FontSize="38" />
                                    <TextBlock Text="{Binding HealthLabel}" Margin="0,3,0,0" FontFamily="Segoe UI Semibold" FontSize="18" />
                                    <TextBlock Text="Pontuação inicial baseada em espaço, memória, inicialização e estado do Windows."
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="5,0">
                                <StackPanel>
                                    <TextBlock Text="MEMÓRIA" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding MemoryUsagePercent, StringFormat={}{0:0}%}"
                                               Margin="0,10,0,0"
                                               FontFamily="Segoe UI Semibold"
                                               FontSize="32" />
                                    <TextBlock Text="{Binding MemorySummary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <ProgressBar Value="{Binding MemoryUsagePercent}" Maximum="100" Height="8" Margin="0,14,0,0" />
                                    <TextBlock Text="{Binding ProcessSummary}"
                                               Margin="0,10,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="INICIALIZAÇÃO" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding StartupItemCount}"
                                               Margin="0,10,0,0"
                                               FontFamily="Segoe UI Semibold"
                                               FontSize="32" />
                                    <TextBlock Text="entradas detectadas" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding UptimeSummary}"
                                               Margin="0,13,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="0.85*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Componentes principais" FontFamily="Segoe UI Semibold" FontSize="18" />
                                    <Border Margin="0,16,0,0" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="PROCESSADOR" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding Processor}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,10,0,0" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="PLACA DE VÍDEO" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding GraphicsAdapter}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Armazenamento" FontFamily="Segoe UI Semibold" FontSize="18" />
                                    <ItemsControl ItemsSource="{Binding Drives}" Margin="0,14,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="13" Margin="0,0,0,9">
                                                    <StackPanel>
                                                        <TextBlock FontFamily="Segoe UI Semibold">
                                                            <Run Text="{Binding Name}" />
                                                            <Run Text="  " />
                                                            <Run Text="{Binding Label}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11">
                                                            <Run Text="{Binding FreeGb}" />
                                                            <Run Text=" GB livres de " />
                                                            <Run Text="{Binding TotalGb}" />
                                                            <Run Text=" GB · " />
                                                            <Run Text="{Binding FreePercent}" />
                                                            <Run Text="% livre" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Pontos encontrados" FontFamily="Segoe UI Semibold" FontSize="18" />
                                    <TextBlock Text="{Binding StatusText}"
                                               HorizontalAlignment="Right"
                                               MaxWidth="420"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,15,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Semibold" FontSize="14" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Margin="0,5,0,0"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               LineHeight="18" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsHardwareVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Processador" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding Processor}" Margin="0,8,0,0" FontFamily="Segoe UI Semibold" FontSize="18" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Adaptador gráfico" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding GraphicsAdapter}" Margin="0,8,0,0" FontFamily="Segoe UI Semibold" FontSize="18" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Memória física" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding MemorySummary}" Margin="0,8,0,0" FontFamily="Segoe UI Semibold" FontSize="18" />
                                <ProgressBar Value="{Binding MemoryUsagePercent}" Maximum="100" Height="10" Margin="0,16,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsStorageVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontFamily="Segoe UI Semibold" FontSize="20">
                                                    <Run Text="{Binding Name}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding Label}" />
                                                </TextBlock>
                                                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="Sistema de arquivos: " />
                                                    <Run Text="{Binding FileSystem}" />
                                                </TextBlock>
                                                <ProgressBar Value="{Binding FreePercent}" Maximum="100" Height="10" Margin="0,16,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="26,0,0,0" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding FreePercent, StringFormat={}{0:0}% livre}" FontFamily="Segoe UI Semibold" FontSize="23" HorizontalAlignment="Right" />
                                                <TextBlock HorizontalAlignment="Right" Margin="0,7,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding FreeGb}" />
                                                    <Run Text=" GB de " />
                                                    <Run Text="{Binding TotalGb}" />
                                                    <Run Text=" GB" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsStartupVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Entradas detectadas" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding StartupItemCount}" Margin="0,9,0,0" FontFamily="Segoe UI Semibold" FontSize="42" />
                                    <TextBlock Text="{Binding StartupSummary}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Tempo ligado" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding UptimeSummary}" Margin="0,12,0,0" FontFamily="Segoe UI Semibold" FontSize="19" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                            <TextBlock Text="A próxima etapa mostrará cada programa de inicialização com impacto, fabricante e opção segura para desativar."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsUpdatesVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Estado do Windows" FontFamily="Segoe UI Semibold" FontSize="19" />
                                <TextBlock Text="{Binding SystemSummary}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RestartSummary}" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                            <TextBlock Text="A leitura de Windows Update, WinGet e versões de drivers será adicionada sem instalar nada automaticamente."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsOptimizationsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Otimizações bloqueadas nesta prévia" FontFamily="Segoe UI Semibold" FontSize="20" />
                                <TextBlock Text="Antes de habilitar qualquer mudança, vamos implementar ponto de restauração, registro de cada ação e botão de desfazer."
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           LineHeight="20" />
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="3" Margin="0,16,0,0">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Inicialização" FontFamily="Segoe UI Semibold" FontSize="17" />
                                    <TextBlock Text="Revisar programas que carregam com o Windows." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="Armazenamento" FontFamily="Segoe UI Semibold" FontSize="17" />
                                    <TextBlock Text="Limpeza explicada sem apagamento agressivo." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Energia" FontFamily="Segoe UI Semibold" FontSize="17" />
                                    <TextBlock Text="Perfis adequados ao hardware e ao uso real." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>