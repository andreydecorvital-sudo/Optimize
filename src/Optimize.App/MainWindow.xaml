<Window x:Class="Optimize.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimize"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#0D1118"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="22,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="OPTIMIZE"
                               FontFamily="Segoe UI Semibold"
                               FontSize="25" />
                    <TextBlock Text="PC INSPECTION"
                               Margin="1,3,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Background="#1B2330" CornerRadius="9" Padding="14,11" Margin="0,0,0,8">
                        <TextBlock Text="Visão geral" FontFamily="Segoe UI Semibold" />
                    </Border>
                    <TextBlock Text="Hardware" Padding="14,10" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Armazenamento" Padding="14,10" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Inicialização" Padding="14,10" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Atualizações" Padding="14,10" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Otimizações" Padding="14,10" Foreground="#5E6877" />
                </StackPanel>

                <Border Grid.Row="4"
                        Background="#121824"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="13">
                    <StackPanel>
                        <TextBlock Text="MODO SEGURO"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="11"
                                   Foreground="#70D6A7" />
                        <TextBlock Text="Esta versão apenas lê informações. Nenhuma configuração é alterada."
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="34,28,34,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Visão geral do computador"
                                   FontSize="28"
                                   FontFamily="Segoe UI Semibold" />
                        <TextBlock Text="{Binding SystemSummary}"
                                   Margin="0,7,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LastScanText}"
                                   Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="#6F7A89" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding ScanCommand}"
                            Content="{Binding ScanButtonText}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="176"
                            VerticalAlignment="Top" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="92" Height="92" CornerRadius="46" Background="#211B43">
                                <Grid>
                                    <TextBlock Text="{Binding Score}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe UI Semibold"
                                               FontSize="34" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="18,5,0,0">
                                <TextBlock Text="NOTA DO PC"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           FontFamily="Segoe UI Semibold" />
                                <TextBlock Text="{Binding HealthLabel}"
                                           Margin="0,7,0,0"
                                           FontSize="22"
                                           FontFamily="Segoe UI Semibold" />
                                <TextBlock Text="Pontuação inicial baseada em espaço, memória, inicialização e estado do Windows."
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="MEMÓRIA"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontFamily="Segoe UI Semibold" />
                            <TextBlock Text="{Binding MemorySummary}"
                                       Margin="0,13,0,0"
                                       FontSize="17"
                                       FontFamily="Segoe UI Semibold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProcessSummary}"
                                       Margin="0,9,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="INICIALIZAÇÃO"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontFamily="Segoe UI Semibold" />
                            <TextBlock Text="{Binding StartupSummary}"
                                       Margin="0,13,0,0"
                                       FontSize="17"
                                       FontFamily="Segoe UI Semibold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding UptimeSummary}"
                                       Margin="0,9,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="22">
                        <StackPanel>
                            <TextBlock Text="Hardware detectado"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="18" />
                            <TextBlock Text="Processador"
                                       Margin="0,20,0,4"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" />
                            <TextBlock Text="{Binding Processor}" TextWrapping="Wrap" />
                            <TextBlock Text="Adaptador gráfico"
                                       Margin="0,18,0,4"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" />
                            <TextBlock Text="{Binding GraphicsAdapter}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="22">
                        <StackPanel>
                            <TextBlock Text="Armazenamento"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="18" />
                            <ItemsControl ItemsSource="{Binding Drives}" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceSecondaryBrush}"
                                                CornerRadius="9"
                                                Padding="12"
                                                Margin="0,0,0,9">
                                            <StackPanel>
                                                <TextBlock FontFamily="Segoe UI Semibold">
                                                    <Run Text="{Binding Name}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding Label}" />
                                                </TextBlock>
                                                <TextBlock Margin="0,5,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12">
                                                    <Run Text="{Binding FreeGb}" />
                                                    <Run Text=" GB livres de " />
                                                    <Run Text="{Binding TotalGb}" />
                                                    <Run Text=" GB · " />
                                                    <Run Text="{Binding FreePercent}" />
                                                    <Run Text="% livre" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="6"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="22">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pontos encontrados"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="18" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="15"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontFamily="Segoe UI Semibold"
                                                           FontSize="14" />
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="0,5,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           LineHeight="19" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="#202A39"
                                                    CornerRadius="7"
                                                    Padding="9,5"
                                                    Margin="16,0,0,0"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Severity}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
