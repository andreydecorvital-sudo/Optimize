<!-- Optimize · dynamic missions panel · SysManager upstream MIT license preserved -->
<UserControl x:Class="SysManager.Views.OptimizeMissionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MISSÕES DO OPTIMIZE"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Text="O que vale a pena fazer neste PC"
                               FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding OptimizeHardwareSummary}"
                               FontSize="11" Foreground="{DynamicResource TextSecondary}"
                               Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Atualizar missões"
                        Command="{Binding RefreshOptimizeMissionsCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="13,7" VerticalAlignment="Top"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,12">
                <ProgressBar IsIndeterminate="True" Width="70" Height="4"
                             VerticalAlignment="Center" Margin="0,0,10,0"
                             Visibility="{Binding IsOptimizeMissionsLoading, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding OptimizeMissionStatus}"
                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding OptimizeMissions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource Border1}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{DynamicResource AccentSoft}"
                                                CornerRadius="999" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding PriorityLabel}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Accent}"/>
                                        </Border>
                                        <TextBlock Text="{Binding RiskLabel}"
                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Summary}"
                                               FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="18"/>
                                    <TextBlock Text="{Binding WhyItMatters}"
                                               FontSize="11" Foreground="{DynamicResource TextMuted}"
                                               Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="17"/>

                                    <Border Background="{DynamicResource Surface3}"
                                            CornerRadius="7" Padding="10,7" Margin="0,9,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Evidence}"
                                                       FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding HardwareContext}"
                                                       FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{Binding ActionLabel}"
                                        Click="MissionAction_Click"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,7" VerticalAlignment="Center"
                                        MinWidth="145"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
